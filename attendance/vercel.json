{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/c/(.*)", "destination": "/checkin.html" }
  ],
  "headers": [
    { "source": "/checkin.html", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
